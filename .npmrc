# -----------------------------------------------------------------------------
# Dependency admission, VG-12 (STRATEGY section 4.2)
# -----------------------------------------------------------------------------
# The build method is AI-assisted and hallucinated package names recur
# predictably, so every one of these settings exists to make a dependency
# arrive as a decision rather than as a side effect.

# A range is a version nobody chose. `--frozen-lockfile` pins the tree, but a
# caret in package.json still means the next `pnpm add` writes a different
# resolution than the one a human approved.
save-exact=true

# THE ENGINE'S PURITY BOUNDARY DEPENDS ON THIS ONE. Under a hoisted layout an
# undeclared import resolves anyway, so `packages/rules-engine` could import a
# package it does not declare and the manifest check in
# packages/tooling/checks/repo-invariants.mjs would still report it clean.
# Isolated linking is pnpm's default; it is written down because the default is
# load-bearing here rather than incidental.
node-linker=isolated

# A peer range that does not hold is a compatibility claim nobody checked. It
# is a warning rather than an install failure, because the alternative on a
# workspace this size is a blocked install on a transitive peer nobody owns.
strict-peer-dependencies=false

# There is deliberately NO `engine-strict` and no `engines` field: the Node
# version lives in .nvmrc and nowhere else (OQ-P1-03, rider 3). Two files
# holding one number is a hand-maintained count in a different costume.
