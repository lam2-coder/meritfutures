{
  "$schema": "https://json.schemastore.org/tsconfig",

  // Every package extends this file by relative path rather than through a
  // `@merit/tooling` package reference, so `tsc` needs no install to resolve
  // its own base config. P1 section 2.1's argument for the tooling package is
  // that each application must not grow its own copy of the base config; one
  // file at the root, extended everywhere, is the strongest form of that.
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    // Type-check only. Nothing in this repository is built by `tsc`: the apps
    // are bundled by their own frameworks and the libraries are consumed from
    // source by Vitest. CI-01 runs `tsc --noEmit` and that is the whole job.
    "noEmit": true,

    // A RELATIVE IMPORT NAMES THE FILE IT ACTUALLY IS, because two resolvers
    // read this tree and only one of them rewrites extensions. `tsc` under
    // `moduleResolution: NodeNext` wants `./x.js` for a file that is `x.ts`;
    // `node --experimental-strip-types`, which ADR-083 rules is how every
    // deployable runs, resolves an import specifier to THE FILE IT NAMES and
    // maps nothing. So `./x.js` type-checked and could not run: every app died
    // on its own first relative import with ERR_MODULE_NOT_FOUND, measured in
    // session 209 across `apps/api`, `apps/admin` and `apps/worker`.
    //
    // This flag is what lets the specifier say `./x.ts` and satisfy both. It
    // requires `noEmit`, which is set above and is not a coincidence: nothing
    // here is built by `tsc`, so there is no emitted output whose specifiers
    // could be wrong. Without it `tsc` reports TS5097 on every rewritten line.
    "allowImportingTsExtensions": true,

    "strict": true,

    // The five that `strict` does not turn on, each of which has bitten a money
    // path somewhere. `noUncheckedIndexedAccess` is the one that matters most
    // here: `dayMarks[i]` is `DayMark | undefined`, which is the truth.
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,

    // A file that cannot be understood alone cannot be transpiled alone, and
    // every transform in this tree (Vitest, and whatever bundles the apps) is a
    // single-file transform. `verbatimModuleSyntax` makes the import/export
    // elision rules explicit instead of inferred.
    "isolatedModules": true,
    "verbatimModuleSyntax": true,

    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  }
}
